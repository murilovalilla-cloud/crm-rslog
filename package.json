{
  "name": "crm-rslog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CRM de prospecção ativa da RS LOG — frontend React/Vite e backend Cloudflare Workers + D1",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "dev:all": "concurrently -k -n web,api -c blue,green \"npm:dev\" \"npm:dev:worker\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --ext ts,tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:create": "wrangler d1 create crm-rslog-db",
    "db:migrate:local": "wrangler d1 migrations apply crm-rslog-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply crm-rslog-db --remote",
    "db:seed:local": "wrangler d1 execute crm-rslog-db --local --file=./migrations/0002_seed_data.sql",
    "db:seed:remote": "wrangler d1 execute crm-rslog-db --remote --file=./migrations/0002_seed_data.sql",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@e965/xlsx": "^0.20.3",
    "@tanstack/react-query": "^5.59.0",
    "date-fns": "^3.6.0",
    "hono": "^4.6.9",
    "jose": "^6.2.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.14",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "wrangler": "^3.83.0"
  }
}
